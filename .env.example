# Copy this file to .env and put your real key there. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key

# Free-tier model that is well suited to translation.
GEMINI_MODEL=gemini-3.5-flash-lite

# Conservative pacing for free-tier request limits. Set to 0 to disable.
GEMINI_RPM=10

# Required for fetch_subs.py. Create one at
# https://www.opensubtitles.com/en/users/settings/api
OPENSUBTITLES_API_KEY=your-opensubtitles-api-key

# Optional OpenSubtitles account. Signing in raises the daily download limit
# from 5 (anonymous) to 20.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Optional TMDB key. Without it, fetch_subs.py searches by title text only.
TMDB_API_KEY=

# fetch_subs.py defaults. SUBS_MAX_DOWNLOADS overrides the limit implied by
# whether you signed in (20) or not (5).
SUBS_PREFERRED_LANG=bg
SUBS_FALLBACK_LANG=en
SUBS_MAX_DOWNLOADS=20
